  "keywords": [
    "ai",
    "ai-agent",
    "ai-agents",
    "ai-coding",
    "coding-agent",
    "agentic-workflow",
    "multi-agent",
    "sub-agents",
    "llm",
    "prompt-engineering",
    "agents-md",
    "agent-skills",
    "claude-code",
    "github-copilot",
    "codex",
    "cursor",
    "gemini-cli",
    "code-review",
    "spec-driven-development",
    "developer-tools",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "pirl-framework": "bin/pirl.mjs"
  },
  "files": [
    ".gitignore",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTEXT.md",
    ".agents/instructions/",
